/* lexical analyzer demo: comment is ignored */
const m = 7, n = 85;
var x, y, z;
procedure multiply;
    var a, b;
    begin
        a := x;
        b := y;
        z := 0;
        while b > 0 do
        begin
            if odd b then z := z + a;
            a := 2 * a;
            b := b / 2
        end
    end;
begin
    read(x);
    read(y);
    call multiply;
    write(z)
end.

